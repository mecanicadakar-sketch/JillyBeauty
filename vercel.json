{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/clientes",
      "destination": "/clientes.html"
    },
    {
      "source": "/clientes/",
      "destination": "/clientes.html"
    },
    {
      "source": "/clientes/(.*)",
      "destination": "/clientes.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
